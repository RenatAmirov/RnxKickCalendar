<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="ru-RU" Title="Календарик-пинарик"
        WindowStartupLocation="CenterScreen" Width="1280" Height="830"
        MinWidth="1020" MinHeight="600" Background="#F6F3EC"
        FontFamily="Segoe UI" FontSize="13" Foreground="#242821"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#242821" />
    <SolidColorBrush x:Key="Muted" Color="#625E54" />
    <SolidColorBrush x:Key="Accent" Color="#9B382A" />
    <SolidColorBrush x:Key="Rule" Color="#DED8CA" />
    <SolidColorBrush x:Key="Paper" Color="#FFFCF5" />

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PaperCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Paper}" />
      <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="Quiet" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Paper}" />
      <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#AB8F78" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="Background" Value="#F5C7AD" />
      <Setter Property="BorderBrush" Value="#F5C7AD" />
      <Setter Property="Foreground" Value="#3D211C" />
      <Setter Property="MinHeight" Value="37" />
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="23" />
    </Style>
    <Style x:Key="YearChip" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0,0,5,5" />
    </Style>
    <Style x:Key="Cell" TargetType="Button">
      <Setter Property="Margin" Value="1,1" />
      <Setter Property="Height" Value="23" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" ClipToBounds="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#9B382A" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="#FFFCF5" BorderBrush="{StaticResource Rule}"
            BorderThickness="0,0,0,1" Padding="25,11">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Pin" Style="{StaticResource Quiet}" Margin="0,0,8,0" />
          <Button x:Name="Settings" Content="Настройки" Style="{StaticResource Quiet}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource Accent}">
            <Path Data="M 3,5 H 19 V 19 H 3 Z M 3,9 H 19 M 7,2 V 7 M 15,2 V 7 M 7,16 L 15,11"
                  Width="22" Height="22" Stroke="#FFF6E9" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Календарик-пинарик" FontFamily="Georgia" FontSize="23" />
            <TextBlock Text="ПРАКТИКА ПО МЕТОДУ ДМИТРИЯ ЛИТВАКА" Style="{StaticResource Caption}" Margin="1,3,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MaxWidth="1460" Margin="24,14,24,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="270" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource PaperCard}" Padding="15,10" Margin="0,0,0,11">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock Text="Прожитые годы" Style="{StaticResource Section}" />
                <TextBlock x:Name="PastCount" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
              </DockPanel>
              <WrapPanel x:Name="PastYears" Margin="0,7,0,-5" />
              <DockPanel x:Name="BirthPrompt" Margin="0,4,0,0">
                <Button x:Name="SetBirth" Content="Указать год рождения  ›"
                        Style="{StaticResource Link}" DockPanel.Dock="Right" />
                <TextBlock Text="Добавьте год рождения, чтобы начать вычёркивать прожитые годы."
                           Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PaperCard}" Padding="14,10,14,11" Margin="0,0,0,11">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="ThisYear" Content="К текущему" Style="{StaticResource Quiet}" Margin="0,0,7,0" />
                  <Button x:Name="PrevYear" Content="‹" Width="31" Padding="0" FontSize="19"
                          Style="{StaticResource Quiet}" Margin="0,0,4,0" ToolTip="Предыдущий год"
                          AutomationProperties.Name="Предыдущий год" />
                  <Button x:Name="NextYear" Content="›" Width="31" Padding="0" FontSize="19"
                          Style="{StaticResource Quiet}" ToolTip="Следующий год"
                          AutomationProperties.Name="Следующий год" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="YearHeading" FontFamily="Georgia" FontSize="37" />
                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="YearLabel" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="DayCount" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                  </StackPanel>
                </StackPanel>
              </DockPanel>
              <Grid x:Name="DaysGrid" Margin="0,5,0,0" KeyboardNavigation.DirectionalNavigation="Contained" />
              <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,8,0,0">
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,13,0">
                    <Border Width="15" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="#9B382A" Background="#FFF1DA" />
                    <TextBlock Text="Сегодня" Margin="5,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,13,0">
                    <Border Width="15" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="#E2C7B4" Background="#FFF2E4">
                      <Path Data="M 0,12 L 13,0 L 0,0 Z" Fill="#E4A88C" Stretch="Fill" />
                    </Border>
                    <TextBlock Text="Отмечено утро" Margin="5,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="15" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="#A9AF9F" Background="#DDE3D4">
                      <Path Data="M 2,10 L 11,2 M 2,2 L 11,10" Stroke="#51604B" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="День зачёркнут" Margin="5,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" />
                  </StackPanel>
                </WrapPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PaperCard}" Padding="15,10">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock Text="Будущие годы" Style="{StaticResource Section}" />
                <TextBlock x:Name="FutureRange" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
              </DockPanel>
              <WrapPanel x:Name="FutureYears" Margin="0,7,0,-5" />
              <TextBlock x:Name="NoFuture" Text="Горизонт заканчивается в этом году. Его можно изменить в настройках."
                         Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Background="#392728" CornerRadius="12" Padding="16,14,16,12" TextElement.Foreground="#FFF7EB">
            <StackPanel>
              <TextBlock Text="СЕГОДНЯ" Style="{StaticResource Caption}" Foreground="#F5C7AD" />
              <TextBlock x:Name="TodayDate" FontFamily="Georgia" FontSize="31" Margin="0,4,0,1" />
              <TextBlock x:Name="TodayWeekday" Foreground="#E7CFC5" FontSize="13" />
              <Border BorderBrush="#6A504D" BorderThickness="0,1,0,0" Margin="0,13,0,9" />
              <DockPanel Margin="0,0,0,7">
                <TextBlock x:Name="MorningIcon" DockPanel.Dock="Left" Width="23"
                           Foreground="#F5C7AD" FontWeight="SemiBold" />
                <TextBlock Text="Утром — половина дня" />
              </DockPanel>
              <DockPanel Margin="0,0,0,11">
                <TextBlock x:Name="EveningIcon" DockPanel.Dock="Left" Width="23"
                           Foreground="#F5C7AD" FontWeight="SemiBold" />
                <TextBlock Text="Вечером — весь день" />
              </DockPanel>
              <Button x:Name="MarkToday" Style="{StaticResource Primary}" />
              <Button x:Name="ClearToday" Content="Снять отметку" Style="{StaticResource Link}" Foreground="#F5C7AD"
                      HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PaperCard}" Padding="15,13" Margin="0,11,0,0">
            <StackPanel>
              <TextBlock x:Name="GoalsHeading" Style="{StaticResource Section}" />
              <TextBlock Text="Что важно успеть в этом году?" Foreground="{StaticResource Muted}"
                         FontSize="12" Margin="0,4,0,9" />
              <Grid>
                <TextBox x:Name="Goals" Height="118" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="10000"
                         Padding="8,6" Background="#F8F4EA" BorderBrush="{StaticResource Rule}"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Цели на выбранный год" />
                <TextBlock x:Name="GoalsPlaceholder" Text="Запишите главные цели…" Foreground="{StaticResource Muted}"
                           IsHitTestVisible="False" Margin="10,8,8,0" VerticalAlignment="Top" />
              </Grid>
              <TextBlock x:Name="SaveStatus" Text="Сохраняется на этом компьютере" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <StackPanel Margin="3,12,3,0">
            <TextBlock Text="КАК ПОЛЬЗОВАТЬСЯ" Style="{StaticResource Caption}" />
            <TextBlock Text="Нажмите на прошедший день или год, чтобы зачеркнуть его. Правый щелчок по дню снимет отметку."
                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                       LineHeight="17" Margin="0,5,0,0" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
